{
  "$comment": "Read by tools/gates/check.mjs on every agent PR. Changing this file is itself a protected change.",
  "maxChangedLines": 400,
  "protectedPaths": [
    "services/api/src/auth.ts",
    "db/migrations/**",
    ".github/**",
    ".claude/**",
    ".lane/**",
    "tools/gates/**",
    "scripts/**",
    "docker-compose*.yml",
    "**/Dockerfile"
  ],
  "allowedDependencies": {
    "npm": ["@biomejs/biome", "@types/node", "@types/pg", "fastify", "pg", "tsx", "typescript", "vitest"],
    "go": ["github.com/jackc/pgx/v5"]
  },
  "ignoreFromLineCount": ["pnpm-lock.yaml", "**/go.sum"]
}
